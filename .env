# Local, self-contained SQLite database — created automatically by `npm run dev`
# (via `prisma db push`, run as a predev step). No external database needed.
# On Vercel the app runs against a copy of this database in /tmp (see
# src/lib/prisma.ts), so deploying needs no database setup or env vars either.
DATABASE_URL="file:./dev.db"

# Dev-only secret used to sign local session JWTs. Committed on purpose so a fresh
# clone works out of the box. For a real deployment, set your own SESSION_SECRET
# in the Vercel project settings. Regenerate anytime with: openssl rand -base64 32
SESSION_SECRET="3mkXS2jKWjB8nKPiNciH0Euf/rdnXH7kEmhwmCGNRWU="
