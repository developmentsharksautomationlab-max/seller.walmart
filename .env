# Local, self-contained SQLite database — created automatically by `npm run dev`
# (via `prisma db push`, run as a predev step). No external database needed.
DATABASE_URL="file:./dev.db"

# Dev-only secret used to sign local session JWTs. Committed on purpose so a fresh
# clone works out of the box — it only signs sessions against your own local SQLite
# database, never production (Vercel sets its own SESSION_SECRET). Regenerate anytime
# with: openssl rand -base64 32
SESSION_SECRET="3mkXS2jKWjB8nKPiNciH0Euf/rdnXH7kEmhwmCGNRWU="
